{
  "name": "hodoku",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "description": "Chrome extension: highlight Japanese text to get romaji, a word-by-word breakdown, and the meaning.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "build:dict": "node scripts/build-dict.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:screenshots": "node scripts/build-screenshots.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:anki": "node scripts/smoke-anki.mjs",
    "package": "node scripts/package.mjs",
    "release": "npm run build:icons && npm run build:dict && npm run typecheck && npm run build && npm run test && npm run smoke && npm run smoke:anki && npm run package"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "kuromoji": "^0.1.2",
    "openai": "^7.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.278",
    "@types/node": "^22.20.1",
    "esbuild": "^0.24.0",
    "puppeteer": "^25.4.0",
    "typescript": "^5.6.3"
  }
}
