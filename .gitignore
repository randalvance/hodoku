# Dependencies
node_modules/

# Build output
dist/
release/
*.zip
.cache/
*.tsbuildinfo

# Downloaded dictionary sources (regenerated by `npm run build:dict`)
vendor/

# The compiled dictionary is ~9 MB of generated data — rebuild it, don't commit
# it. Its metadata is tracked, because that records which JMdict release a given
# build came from, and NOTICE.md points at it for attribution.
public/dict/*.bin
public/dict/*.json
!public/dict/.gitkeep
!public/dict/jmdict.meta.json

# Scratch space used while debugging in the container
.probe/

# Temporary screenshots from `npm run build:screenshots` iterations. The
# committed preview-*.png files are the real store assets.
store/assets/tmp-*

# Candidate marks from `node scripts/icon-options.mjs`. The chosen design is
# frozen into build-icons.mjs; these are throwaway comparisons.
store/assets/icon-options/

# Secrets. Nothing in this project should ever hold a real API key — keys live
# in chrome.storage.local at runtime — but this is the cheap insurance.
.env
.env.*
!.env.example
*.pem
*.key

# Agent/editor local settings. settings.local.json is per-developer; a shared
# .claude/settings.json would be committed deliberately.
.claude/settings.local.json
.vscode/
.idea/
*.swp
*~

# Logs
*.log
npm-debug.log*
yarn-error.log*

# OS cruft. ._* matters here: macOS resource forks would otherwise ride along
# into the store zip, which is why scripts/package.mjs also passes `zip -X`.
.DS_Store
._*
Thumbs.db
